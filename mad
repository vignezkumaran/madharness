#!/usr/bin/env sh
set -e
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -f "$DIR/packages/cli/dist/index.js" ]; then
  echo "Build MAD first: npm run build" >&2
  exit 1
fi
if ! command -v node >/dev/null 2>&1; then
  NVM_DIR=${NVM_DIR:-"$HOME/.nvm"}
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    . "$NVM_DIR/nvm.sh" --no-use
    nvm use --silent default >/dev/null 2>&1 || true
  fi
fi
if ! command -v node >/dev/null 2>&1; then
  for NODE_BIN in /opt/homebrew/bin /usr/local/bin "$HOME/.local/share/fnm/aliases/default/bin"; do
    if [ -x "$NODE_BIN/node" ]; then PATH="$NODE_BIN:$PATH"; export PATH; break; fi
  done
fi
if ! command -v node >/dev/null 2>&1; then
  echo 'Node.js was not found. Install Node.js or enable it in your shell, then run ./mad again.' >&2
  exit 127
fi
exec node "$DIR/packages/cli/dist/index.js" "$@"
