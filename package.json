{
  "name": "mad-harness",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@mad-harness/cli",
    "build": "npm run build --workspace=@mad-harness/cli",
    "chat": "npx tsx packages/cli/src/index.ts chat",
    "run:pipeline": "npx tsx packages/cli/src/index.ts run",
    "benchmark": "npx tsx packages/cli/src/index.ts benchmark",
    "status": "npx tsx packages/cli/src/index.ts status",
    "ask": "node packages/cli/dist/index.js ask",
    "mad": "node packages/cli/dist/index.js"
  }
}
